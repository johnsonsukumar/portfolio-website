<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Private Theatre Meta Ads Playbook — Karnataka</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #f0a500;
    --gold-light: #ffd166;
    --dark: #080e1a;
    --dark-2: #0d1828;
    --dark-3: #111f33;
    --card: #0f1e32;
    --border: rgba(240,165,0,0.18);
    --text: #e8edf5;
    --muted: rgba(232,237,245,0.5);
    --green: #22c55e;
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Syne', sans-serif;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── NOISE OVERLAY ── */
  body::before {
    content:'';
    position:fixed; inset:0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events:none; z-index:0; opacity:0.4;
  }

  /* ── GLOW ORBS ── */
  .orb {
    position:fixed; border-radius:50%;
    pointer-events:none; z-index:0; filter:blur(80px);
  }
  .orb1 { width:500px; height:500px; background:rgba(240,165,0,0.06); top:-100px; right:-100px; }
  .orb2 { width:400px; height:400px; background:rgba(34,197,94,0.04); bottom:20%; left:-100px; }
  .orb3 { width:300px; height:300px; background:rgba(240,165,0,0.05); bottom:-50px; right:20%; }

  /* ── LAYOUT ── */
  .container { max-width: 860px; margin: 0 auto; padding: 0 24px; position:relative; z-index:1; }

  /* ── NAV ── */
  nav {
    padding: 20px 0;
    border-bottom: 0.5px solid var(--border);
    position: sticky; top:0; z-index:100;
    background: rgba(8,14,26,0.85);
    backdrop-filter: blur(20px);
  }
  .nav-inner {
    max-width:860px; margin:0 auto; padding:0 24px;
    display:flex; justify-content:space-between; align-items:center;
  }
  .nav-logo {
    font-family:'Playfair Display',serif;
    font-size:15px; color:var(--gold); letter-spacing:0.5px;
  }
  .nav-cta {
    background:var(--gold); color:var(--dark);
    font-size:13px; font-weight:700;
    padding:9px 20px; border-radius:6px;
    text-decoration:none; letter-spacing:0.5px;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .nav-cta:hover { transform:translateY(-1px); box-shadow:0 8px 24px rgba(240,165,0,0.3); }

  /* ── HERO ── */
  .hero {
    padding: 80px 0 64px;
    text-align: center;
  }

  .hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(240,165,0,0.1); border:0.5px solid rgba(240,165,0,0.3);
    border-radius:20px; padding:6px 16px;
    font-size:12px; font-weight:600; color:var(--gold);
    letter-spacing:1.5px; text-transform:uppercase;
    margin-bottom:28px;
    animation: fadeUp 0.6s ease both;
  }

  .hero-title {
    font-family:'Playfair Display',serif;
    font-size:clamp(36px, 6vw, 58px);
    line-height:1.1; font-weight:900;
    margin-bottom:20px;
    animation: fadeUp 0.6s 0.1s ease both;
  }
  .hero-title .hl { color:var(--gold); position:relative; }
  .hero-title .hl::after {
    content:'';
    position:absolute; bottom:-4px; left:0; right:0;
    height:2px; background:var(--gold); opacity:0.4;
    border-radius:2px;
  }

  .hero-sub {
    font-size:17px; color:var(--muted); line-height:1.7;
    max-width:580px; margin:0 auto 40px;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .hero-price-block {
    display:inline-flex; flex-direction:column; align-items:center;
    gap:4px; margin-bottom:32px;
    animation: fadeUp 0.6s 0.3s ease both;
  }
  .price-label { font-size:12px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; }
  .price-amount {
    font-family:'Playfair Display',serif;
    font-size:52px; font-weight:900; color:var(--gold);
    line-height:1;
  }
  .price-note { font-size:12px; color:var(--muted); }

  .hero-btn {
    display:inline-block;
    background:var(--gold); color:var(--dark);
    font-size:16px; font-weight:700;
    padding:18px 44px; border-radius:8px;
    text-decoration:none; letter-spacing:0.5px;
    transition: transform 0.15s, box-shadow 0.15s;
    animation: fadeUp 0.6s 0.4s ease both;
    margin-bottom:16px;
  }
  .hero-btn:hover { transform:translateY(-2px); box-shadow:0 12px 36px rgba(240,165,0,0.35); }

  .hero-guarantee {
    font-size:13px; color:var(--muted);
    display:flex; align-items:center; justify-content:center; gap:6px;
    animation: fadeUp 0.6s 0.5s ease both;
  }
  .hero-guarantee .dot { color:var(--green); font-size:16px; }

  /* ── SOCIAL PROOF BAR ── */
  .proof-bar {
    border-top: 0.5px solid var(--border);
    border-bottom: 0.5px solid var(--border);
    padding: 20px 0;
    margin-bottom: 72px;
  }
  .proof-inner {
    display:flex; justify-content:center; flex-wrap:wrap; gap:40px;
  }
  .proof-stat { text-align:center; }
  .proof-num {
    font-family:'Playfair Display',serif;
    font-size:26px; font-weight:700; color:var(--gold);
    display:block;
  }
  .proof-label { font-size:12px; color:var(--muted); margin-top:2px; }

  /* ── SECTION LABELS ── */
  .section-label {
    font-size:11px; letter-spacing:3px; text-transform:uppercase;
    color:var(--gold); margin-bottom:12px; display:block;
  }
  .section-heading {
    font-family:'Playfair Display',serif;
    font-size:clamp(26px,4vw,38px); font-weight:700;
    line-height:1.2; margin-bottom:16px;
  }
  .section-sub {
    font-size:15px; color:var(--muted); line-height:1.7;
    max-width:560px; margin-bottom:40px;
  }

  /* ── PROBLEM SECTION ── */
  .problem { padding:72px 0; }
  .problem-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .problem-card {
    background:var(--card); border:0.5px solid rgba(255,60,60,0.15);
    border-radius:12px; padding:22px 20px;
  }
  .problem-icon { font-size:22px; margin-bottom:10px; }
  .problem-title { font-size:14px; font-weight:600; color:#ff6b6b; margin-bottom:6px; }
  .problem-desc { font-size:13px; color:var(--muted); line-height:1.65; }

  /* ── SOLUTION / WHAT YOU GET ── */
  .solution { padding:72px 0; }

  .pdf-mockup {
    background: linear-gradient(135deg, var(--dark-3) 0%, var(--dark-2) 100%);
    border:0.5px solid var(--border);
    border-radius:16px; padding:32px;
    margin-bottom:40px;
    position:relative; overflow:hidden;
  }
  .pdf-mockup::before {
    content:'PDF';
    position:absolute; top:16px; right:16px;
    font-size:10px; font-weight:700; letter-spacing:2px;
    background:rgba(240,165,0,0.15); color:var(--gold);
    border:0.5px solid var(--border);
    padding:4px 10px; border-radius:20px;
  }
  .pdf-title {
    font-family:'Playfair Display',serif;
    font-size:20px; color:#fff; margin-bottom:8px; line-height:1.3;
  }
  .pdf-sub { font-size:13px; color:var(--muted); margin-bottom:24px; }
  .pdf-pages { display:flex; flex-wrap:wrap; gap:8px; }
  .pdf-page {
    background:rgba(240,165,0,0.08); border:0.5px solid var(--border);
    border-radius:6px; padding:8px 12px;
    font-size:12px; color:var(--gold);
  }

  .contents-list { display:flex; flex-direction:column; gap:10px; }
  .content-item {
    display:flex; gap:14px; align-items:flex-start;
    background:var(--card); border:0.5px solid var(--border);
    border-radius:10px; padding:16px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .content-item:hover { border-color:rgba(240,165,0,0.4); transform:translateX(4px); }
  .content-num {
    font-family:'Playfair Display',serif;
    font-size:20px; color:var(--gold); opacity:0.6;
    flex-shrink:0; line-height:1; margin-top:2px;
    width:24px;
  }
  .content-body {}
  .content-title { font-size:14px; font-weight:600; color:#fff; margin-bottom:4px; }
  .content-desc { font-size:12.5px; color:var(--muted); line-height:1.6; }
  .content-tag {
    display:inline-block; margin-top:6px;
    font-size:10px; font-weight:600; letter-spacing:1px; text-transform:uppercase;
    background:rgba(34,197,94,0.1); color:var(--green);
    border:0.5px solid rgba(34,197,94,0.2);
    padding:3px 8px; border-radius:4px;
  }

  /* ── FOR WHOM ── */
  .forwhom { padding:72px 0; }
  .forwhom-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:28px; }
  .fw-card {
    background:var(--card); border:0.5px solid var(--border);
    border-radius:12px; padding:20px 18px;
    display:flex; gap:14px; align-items:flex-start;
  }
  .fw-icon { font-size:24px; flex-shrink:0; }
  .fw-title { font-size:14px; font-weight:600; color:#fff; margin-bottom:4px; }
  .fw-desc { font-size:12.5px; color:var(--muted); line-height:1.6; }

  .cities-row {
    display:flex; flex-wrap:wrap; gap:8px;
    padding:20px; background:var(--card);
    border:0.5px solid var(--border); border-radius:12px;
  }
  .city-chip {
    font-size:12px; font-weight:600;
    background:rgba(240,165,0,0.1); color:var(--gold);
    border:0.5px solid var(--border);
    padding:5px 14px; border-radius:20px;
  }

  /* ── ROI SECTION ── */
  .roi { padding:72px 0; }
  .roi-box {
    background:linear-gradient(135deg, rgba(240,165,0,0.12) 0%, rgba(240,165,0,0.04) 100%);
    border:0.5px solid var(--border);
    border-radius:16px; padding:40px;
  }
  .roi-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:28px; }
  .roi-stat { text-align:center; }
  .roi-num {
    font-family:'Playfair Display',serif;
    font-size:36px; font-weight:900; color:var(--gold);
    display:block; line-height:1;
  }
  .roi-label { font-size:12px; color:var(--muted); margin-top:6px; line-height:1.5; }
  .roi-divider { width:100%; height:0.5px; background:var(--border); margin:24px 0; }
  .roi-calc {
    font-size:15px; color:var(--muted); line-height:1.8; text-align:center;
  }
  .roi-calc strong { color:#fff; }
  .roi-calc .highlight { color:var(--gold); font-weight:700; font-size:17px; }

  /* ── ABOUT ── */
  .about { padding:72px 0; }
  .about-card {
    background:var(--card); border:0.5px solid var(--border);
    border-radius:16px; padding:36px;
    display:flex; gap:28px;
  }
  .about-avatar {
    width:72px; height:72px; border-radius:50%;
    background:linear-gradient(135deg, var(--gold) 0%, #854f0b 100%);
    display:flex; align-items:center; justify-content:center;
    font-family:'Playfair Display',serif; font-size:26px; font-weight:700;
    color:var(--dark); flex-shrink:0;
  }
  .about-body {}
  .about-name { font-size:18px; font-weight:700; color:#fff; margin-bottom:3px; }
  .about-role { font-size:12px; color:var(--gold); letter-spacing:1.5px; text-transform:uppercase; margin-bottom:14px; }
  .about-text { font-size:14px; color:var(--muted); line-height:1.75; }
  .about-pills { display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; }
  .about-pill {
    font-size:11px; padding:4px 12px; border-radius:20px;
    background:rgba(240,165,0,0.1); color:var(--gold);
    border:0.5px solid var(--border);
  }

  /* ── FAQ ── */
  .faq { padding:72px 0; }
  .faq-list { display:flex; flex-direction:column; gap:10px; }
  .faq-item {
    background:var(--card); border:0.5px solid var(--border);
    border-radius:10px; overflow:hidden;
    cursor:pointer;
  }
  .faq-q {
    padding:18px 20px; font-size:14px; font-weight:600; color:#fff;
    display:flex; justify-content:space-between; align-items:center;
    user-select:none;
  }
  .faq-q .arrow { color:var(--gold); font-size:18px; transition:transform 0.25s; }
  .faq-a {
    max-height:0; overflow:hidden;
    transition: max-height 0.3s ease, padding 0.3s;
    font-size:13.5px; color:var(--muted); line-height:1.75;
    padding:0 20px;
  }
  .faq-item.open .faq-a { max-height:300px; padding:0 20px 18px; }
  .faq-item.open .arrow { transform:rotate(45deg); }

  /* ── FINAL CTA ── */
  .final-cta {
    padding:80px 0 100px;
    text-align:center;
  }
  .cta-box {
    background:linear-gradient(135deg, var(--dark-3) 0%, var(--dark-2) 100%);
    border:0.5px solid var(--border);
    border-radius:20px; padding:56px 40px;
    position:relative; overflow:hidden;
  }
  .cta-box::before {
    content:'';
    position:absolute; top:-60px; right:-60px;
    width:240px; height:240px; border-radius:50%;
    border:40px solid rgba(240,165,0,0.08);
    pointer-events:none;
  }
  .cta-box::after {
    content:'';
    position:absolute; bottom:-40px; left:-40px;
    width:160px; height:160px; border-radius:50%;
    border:28px solid rgba(240,165,0,0.05);
    pointer-events:none;
  }
  .cta-tag {
    display:inline-block;
    background:rgba(34,197,94,0.12); color:var(--green);
    border:0.5px solid rgba(34,197,94,0.25);
    font-size:11px; font-weight:700; letter-spacing:2px;
    text-transform:uppercase; padding:6px 16px; border-radius:20px;
    margin-bottom:24px;
  }
  .cta-title {
    font-family:'Playfair Display',serif;
    font-size:clamp(28px,4vw,42px); font-weight:900;
    line-height:1.15; margin-bottom:14px;
  }
  .cta-sub { font-size:15px; color:var(--muted); margin-bottom:36px; line-height:1.7; }
  .cta-price-row {
    display:flex; align-items:center; justify-content:center;
    gap:16px; margin-bottom:28px;
  }
  .cta-orig {
    font-size:18px; color:var(--muted);
    text-decoration:line-through;
  }
  .cta-price {
    font-family:'Playfair Display',serif;
    font-size:44px; font-weight:900; color:var(--gold);
  }
  .cta-save {
    background:rgba(34,197,94,0.15); color:var(--green);
    font-size:12px; font-weight:700;
    padding:4px 10px; border-radius:6px;
  }
  .cta-btn-main {
    display:inline-block;
    background:var(--gold); color:var(--dark);
    font-size:17px; font-weight:700;
    padding:20px 52px; border-radius:8px;
    text-decoration:none; letter-spacing:0.5px;
    transition: transform 0.15s, box-shadow 0.15s;
    margin-bottom:16px; display:block; max-width:380px; margin:0 auto 16px;
  }
  .cta-btn-main:hover { transform:translateY(-2px); box-shadow:0 14px 40px rgba(240,165,0,0.4); }
  .cta-reassure {
    font-size:13px; color:var(--muted);
    display:flex; align-items:center; justify-content:center;
    flex-wrap:wrap; gap:16px; margin-top:16px;
  }
  .cta-reassure span { display:flex; align-items:center; gap:5px; }
  .cta-reassure .tick { color:var(--green); }

  /* ── FOOTER ── */
  footer {
    border-top:0.5px solid var(--border);
    padding:24px 0; text-align:center;
  }
  .footer-text { font-size:12px; color:var(--muted); line-height:1.8; }
  .footer-text a { color:var(--gold); text-decoration:none; }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width:600px) {
    .problem-grid { grid-template-columns:1fr; }
    .forwhom-grid { grid-template-columns:1fr; }
    .roi-grid { grid-template-columns:1fr; gap:16px; }
    .about-card { flex-direction:column; }
    .cta-price-row { flex-direction:column; gap:8px; }
    .proof-inner { gap:24px; }
  }
</style>
</head>
